# Loader ignore rules
# - Use * and ** wildcards
# - Use ! to keep/include a path after a broader ignore
#
# Contoh: di pemweb1/P4 tampil index.php saja
pemweb1/P3/2*.php
pemweb1/P3/4*.php
pemweb1/P3/5*.php
pemweb1/P3/6*.php

pemweb1/P4/*.php
pemweb1/P5/**
pemweb1/P6/**
pemweb1/P7/**/*
pemweb1/P9/**/*
pemweb1/P10/**/*
pemweb1/Tugas_1/**/*

!pemweb1/P4/index.php
!pemweb1/P5/index.php
!pemweb1/P6/index.php
!pemweb1/P7/app/index.php
!pemweb1/P7/laravel/public/index.php
!pemweb1/Tugas_1/index.php

# Contoh lain (opsional): sembunyikan isi rwd, sisakan index.html
# pemweb1/P4/rwd/**
# !pemweb1/P4/rwd/index.html
phpinfo.php
